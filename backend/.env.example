# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cloutculturee?retryWrites=true&w=majority
MONGODB_DB_NAME=cloutculturee

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_this_in_production
JWT_REFRESH_EXPIRY=7d

# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5174

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@cloutculturr.com

# Admin Configuration
ADMIN_EMAIL=your_admin@example.com
ADMIN_PASSWORD=change_this_password

# Default Member Configuration
DEFAULT_MEMBER_EMAIL=member@example.com
DEFAULT_MEMBER_PASSWORD=change_this_password

# NOTE: These credentials are editable through the admin dashboard
# - Admin can change their own password anytime
# - Admin can reset any user password
# - Admin can create new admin accounts
# - Credentials can be customized during setup

# Commission Configuration
DEFAULT_COMMISSION_PERCENTAGE=25
MIN_COMMISSION_PERCENTAGE=20
MAX_COMMISSION_PERCENTAGE=35

# Security
BCRYPT_ROUNDS=10
PASSWORD_RESET_TOKEN_EXPIRY=1h
EMAIL_VERIFICATION_TOKEN_EXPIRY=24h
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15m

# CORS & Security
CORS_ORIGIN=http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Two Factor Auth (Admin)
ENABLE_2FA=true
